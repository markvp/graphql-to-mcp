{
  "name": "@markvp/graphql-to-mcp",
  "version": "1.0.0",
  "description": "A library to convert GraphQL schemas into MCP resources and tools.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "build:types": "tsc --emitDeclarationOnly",
    "build:esbuild": "node esbuild.config.js",
    "build": "npm run clean && npm run build:types && npm run build:esbuild",
    "test": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "prepare": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "graphql",
    "mcp",
    "library",
    "modelcontextprotocol",
    "model-context-protocol",
    "ai"
  ],
  "author": "Mark van Proctor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markvp/graphql-to-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/markvp/graphql-to-mcp/issues"
  },
  "homepage": "https://github.com/markvp/graphql-to-mcp#readme",
  "dependencies": {
    "graphql": "^16.10.0",
    "zod": "^3.21.4"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0"
  },
  "devDependencies": {
    "@types/graphql": "^14.5.0",
    "@types/jest": "^29.0.0",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "esbuild": "^0.25.2",
    "esbuild-node-externals": "^1.18.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.6",
    "jest": "^29.0.0",
    "jiti": "^2.4.2",
    "prettier": "^3.5.3",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  }
}
